# Copier en .env (jamais commité). Contrat : contracts/models.md
NODE_ENV=
APP_PORT=
APP_BASE_URL=
# TRUST_PROXY : nombre de reverse proxys de confiance (ex. 1) ou liste d'adresses ; vide = aucun. « true » refusé.
TRUST_PROXY=
# Conservation RGPD : mois après la date de l'activité avant purge des inscriptions (défaut 12)
RETENTION_MONTHS=
# Contact RGPD affiché sur la page de confidentialité (aucun repli sur ADMIN_EMAIL : vide = non affiché)
CONTACT_EMAIL=
# Limites anti-abus des routes publiques (défauts sûrs : 20 / 10 / 30 / 60) — ne les augmenter qu'en test
RATE_LIMIT_LOGIN_PER_IP_MIN=
RATE_LIMIT_REGISTRATION_PER_IP_MIN=
RATE_LIMIT_REGISTRATION_PER_ACTIVITY_10MIN=
RATE_LIMIT_TOKEN_PER_IP_MIN=
RATE_LIMIT_VIEW_PER_IP_MIN=
DATABASE_URL=
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# MAIL_FROM : expéditeur (adresse unique). Seul : mode stub (rien n envoyé) ; obligatoire dès que SMTP_HOST est renseigné
MAIL_FROM=
CONSENT_TEXT_VERSION=
# Garde-fou des tests : reset de la base (DROP SCHEMA) refuse si son nom ne finit pas par _test.
# ALLOW_DB_RESET=1 force le reset malgre tout. Usage tests uniquement — jamais en QUALIF/PROD.
# ALLOW_DB_RESET=
# Envois groupés (défauts sûrs : 500 / 100 / 5)
MAILING_MAX_RECIPIENTS=
MAILING_SYNC_MAX_RECIPIENTS=
RATE_LIMIT_MAILING_PER_USER_10MIN=
# TLS SMTP imposé hors hôte local (défaut) ; limites des confirmations d'inscription et du désabonnement
SMTP_REQUIRE_TLS=
RATE_LIMIT_CONFIRMATION_PER_ADDRESS_HOUR=
RATE_LIMIT_CONFIRMATION_GLOBAL_HOUR=
RATE_LIMIT_UNSUBSCRIBE_PER_IP_MIN=
