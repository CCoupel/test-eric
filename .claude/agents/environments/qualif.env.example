# Variables specifiques a QUALIF — voir agents/deploy.md section "Fichiers d'Environnement".
# Copier en qualif.env (jamais commite) et completer les valeurs. Surchargent .env (racine).
# Au DEPLOY, .env + qualif.env sont fusionnes dans <dossier de deploiement>/.env, lu par
# docker-compose.qualif.yml (interpolation + env_file). Valeurs sans guillemets ni retour a la ligne.
#
# Application (contrat : contracts/models.md « Variables d'environnement »)
APP_PORT=
APP_BASE_URL=
# Obligatoire, >= 32 caracteres (ex. openssl rand -base64 48 | tr -d '/+=' | cut -c1-48)
SESSION_SECRET=
# Compte admin initial (seed idempotent au demarrage) : ADMIN_EMAIL et ADMIN_PASSWORD (>= 12 car.) ensemble
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Reverse proxy devant l'app : nombre de sauts de confiance (Express trust proxy) ; 0 = aucun (defaut)
TRUST_PROXY=0
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONSENT_TEXT_VERSION=
#
# Base de donnees du conteneur db. DATABASE_URL de l application est DERIVEE dans <deploiement>/.env
# (postgres://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB) au DEPLOY — ne pas la renseigner ici.
# POSTGRES_PASSWORD : caracteres surs pour une URL (lettres, chiffres, - _ .).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
