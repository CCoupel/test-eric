# Variables specifiques a PROD — voir agents/deploy.md section "Fichiers d'Environnement".
# Copier en prod.env (jamais commite ; idealement hors depot/coffre de secrets) et completer.
# Au DEPLOY PROD, le .env de l'application est genere A PARTIR DE CE SEUL FICHIER (le .env racine
# de developpement n'est PAS fusionne en PROD). Valeurs sans guillemets ni retour a la ligne.
# Controles automatiques avant installation : voir deploy.prod.md (Checklist pre-PROD).
#
# --- Cible (voir deploy.prod.md « Decisions a prendre ») -------------------------------------
# local = meme poste (projet compose inscriptions-club-prod) ; ssh = hote distant
PROD_TARGET=local
PROD_HOST=
PROD_SSH_USER=
PROD_SSH_KEY_PATH=
# Dossier d'installation sur l'hote distant (local : build/prod/ du depot)
PROD_INSTALL_DIR=/opt/inscriptions-club
#
# --- Application (contrat : contracts/models.md « Variables d'environnement ») ----------------
NODE_ENV=production
# Port HTTP de l'app sur l'hote, derriere le reverse proxy (different de QUALIF si meme poste)
APP_PORT=8081
# URL publique, OBLIGATOIREMENT en https:// (List-Unsubscribe RFC 8058, cookie Secure)
APP_BASE_URL=https://
# Nombre REEL de reverse proxys devant l'app (Express trust proxy), en general 1.
# 0 uniquement si l'app est exposee sans proxy (incompatible avec https ici). « true » refuse.
TRUST_PROXY=
# Obligatoire, >= 32 caracteres (ex. openssl rand -base64 48 | tr -d '/+=' | cut -c1-48)
SESSION_SECRET=
# Compte admin initial (seed idempotent au demarrage) : ADMIN_PASSWORD >= 12 car., non trivial
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Contact RGPD affiche sur la page de confidentialite (adresse reelle, jamais ADMIN_EMAIL)
CONTACT_EMAIL=
CONSENT_TEXT_VERSION=
RETENTION_MONTHS=12
#
# --- E-mail (pas de mode stub en PROD) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# TLS impose hors hote local : ne jamais mettre false en PROD
SMTP_REQUIRE_TLS=true
# Expediteur : adresse simple (ex. no-reply@club.example), domaine couvert par SPF + DKIM + DMARC
MAIL_FROM=
#
# --- Limites anti-abus (vide = defauts surs du code) ----------------------------------------
# Login : <= 50 en production (refuse au demarrage au-dela) ; defaut 10
RATE_LIMIT_LOGIN_PER_IP_MIN=
RATE_LIMIT_REGISTRATION_PER_IP_MIN=
RATE_LIMIT_REGISTRATION_PER_ACTIVITY_10MIN=
RATE_LIMIT_TOKEN_PER_IP_MIN=
RATE_LIMIT_VIEW_PER_IP_MIN=
RATE_LIMIT_UNSUBSCRIBE_PER_IP_MIN=
RATE_LIMIT_CONFIRMATION_PER_ADDRESS_HOUR=
RATE_LIMIT_CONFIRMATION_GLOBAL_HOUR=
RATE_LIMIT_MAILING_PER_USER_10MIN=
MAILING_MAX_RECIPIENTS=
MAILING_SYNC_MAX_RECIPIENTS=
#
# --- Base de donnees du conteneur db ----------------------------------------------------------
# DATABASE_URL de l'application est DERIVEE au DEPLOY (postgres://USER:PASSWORD@db:5432/DB).
# POSTGRES_PASSWORD : caracteres surs pour une URL (lettres, chiffres, - _ .), different de QUALIF.
POSTGRES_DB=club
POSTGRES_USER=club
POSTGRES_PASSWORD=
