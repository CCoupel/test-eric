  "stack": {
    "backend": {
      "language": "javascript",
      "framework": "node"
    },
    "frontend": {
      "language": "typescript",
      "framework": "react"
    },
    "mobile": null,
    "firmware": null,
    "plugin": null,
    "database": {
      "primary": "postgresql",
      "orm": null
    }
  },
  "infrastructure": {
    "cicd": "github-actions",
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "publish": {
          "mode": "promote",
          "target": "build/qualif_v{X.Y.Z}/"
        },
        "deploy": {
          "mechanism": "docker-compose",
          "target": "docker-compose.qualif.yml"
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml"
        },
        "deploy": {
          "mechanism": "docker-compose",
          "target": "docker-compose.prod.yml"
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "vitest"
    ],
    "frontend": [
      "vitest"
    ],
    "e2e": [
      "playwright"
    ],
    "components": {
      "backend": [
        "src/server/**"
      ],
      "frontend": [
        "src/web/**"
      ]
    },
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50,
    "perf": {
      "p95_ms": 200,
      "p99_ms": 500,
      "error_rate_max": 0.001
    }
  },
  "security": {
    "concerns": [
      "auth",
      "sensitive-data"
    ]
  },
  "commands": {
    "build": "npm run build",
    "test": "npm test",
    "lint": "npm run lint",
    "audit": "npm audit --audit-level=high",
    "ci": "scripts/ci.sh",
    "typecheck": "npm run typecheck",
    "coverage": "npm test -- --coverage",
    "test_fast": "npx vitest run --exclude \"**/*.slow.*\"",
    "test_targeted": "npx vitest run {TARGETS}"
  },
  "docs": {
    "mockup_dir": "docs/mockup"
  },
  "marketing": {
    "site": "auto"
  },
