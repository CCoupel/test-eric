{
  "name": "Inscriptions-club",
  "team_name": "inscriptions-club-team",
  "org": "CCoupel",
  "project": "test-eric",
  "description": "Application web de gestion des inscriptions aux activités d'un club associatif, avec communication groupée aux inscrits.",
  "version": "0.1.0",
  "initialized_at": "2026-10-21T12:53:13Z",
  "initialized_from": "brief",
